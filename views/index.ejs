<%- include('partials/header') %>

<div class="row g-4">
  <!-- Left Column: Creation Form -->
  <div class="col-lg-4">
    <div class="card shadow-sm border-0 sticky-lg-top" style="top: 1.5rem;">
      <div class="card-body p-4">
        <h5 class="card-title fw-bold mb-3 d-flex align-items-center gap-2">
          <i class="bi bi-pencil-square text-primary"></i> New Post
        </h5>
        <form action="/posts" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Author Name</label>
            <input type="text" name="author" class="form-control" placeholder="e.g., Alex Johnson" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Post Title</label>
            <input type="text" name="title" class="form-control" placeholder="Catchy Title" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Category</label>
            <select name="category" class="form-select" required>
              <option value="Tech">Tech</option>
              <option value="Lifestyle">Lifestyle</option>
              <option value="Education">Education</option>
              <option value="General">General</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Content</label>
            <textarea name="content" class="form-control" rows="4" placeholder="Write your thoughts..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100 fw-bold d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-send"></i> Publish
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Right Column: Posts List & Filter -->
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <h4 class="fw-bold m-0">Feed</h4>
      
      <!-- Category Filter -->
      <form action="/" method="GET" class="d-flex align-items-center gap-2">
        <label class="form-label m-0 small fw-semibold text-secondary">Filter:</label>
        <select name="category" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
          <option value="All" <%= selectedCategory === 'All' ? 'selected' : '' %>>All Categories</option>
          <option value="Tech" <%= selectedCategory === 'Tech' ? 'selected' : '' %>>Tech</option>
          <option value="Lifestyle" <%= selectedCategory === 'Lifestyle' ? 'selected' : '' %>>Lifestyle</option>
          <option value="Education" <%= selectedCategory === 'Education' ? 'selected' : '' %>>Education</option>
          <option value="General" <%= selectedCategory === 'General' ? 'selected' : '' %>>General</option>
        </select>
      </form>
    </div>

    <% if (posts.length === 0) { %>
      <div class="alert alert-info border-0 shadow-sm text-center py-4">
        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
        No posts found in this category.
      </div>
    <% } else { %>
      <div class="d-flex flex-column gap-3">
        <% posts.forEach(post => { %>
          <div class="card shadow-sm border-0 blog-card">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary-subtle text-primary fw-semibold px-2.5 py-1">
                  <%= post.category %>
                </span>
                <small class="text-muted fs-7">
                  <i class="bi bi-clock me-1"></i><%= post.createdAt %>
                </small>
              </div>
              <h5 class="card-title fw-bold text-dark mb-1"><%= post.title %></h5>
              <p class="text-muted small mb-3">By <span class="fw-medium text-dark"><%= post.author %></span></p>
              <p class="card-text text-secondary mb-4"><%= post.content %></p>
              
              <div class="d-flex gap-2 justify-content-end border-top pt-3">
                <a href="/posts/<%= post.id %>/edit" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                  <i class="bi bi-pencil"></i> Edit
                </a>
                <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" onclick="return confirm('Delete this post?')">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>